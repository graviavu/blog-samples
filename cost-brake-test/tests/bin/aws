#!/usr/bin/env bash
# Fake aws CLI for tests/run.sh. Understands only the calls the scripts make; anything else exits 99.
. "$(dirname "$0")/stub-lib.sh"
[ "$1" = "--region" ] && shift 2
svc="$1"; cmd="$2"; shift 2
D="${STUB_DIST:-EFAKETEST1234}"
echo "$svc $cmd $*" >> "$S/calls.log"
if [ -n "${STUB_FAIL_NTH:-}" ] && [ "$cmd" = "${STUB_FAIL_NTH%%:*}" ]; then
  n=$(( $(get "n_$cmd" 0) + 1 )); put "n_$cmd" "$n"
  if [ "$n" = "${STUB_FAIL_NTH##*:}" ]; then acct="$(printf '%s%s' 1234 56789012)"; echo "stub: simulated failure of $cmd (arn:aws:iam::$acct:role/x, account $acct, dist $D, host dfaketest.cloudfront.net)" >&2; exit 254; fi
fi
arg() { local k="$1"; shift; while [ $# -gt 0 ]; do if [ "$1" = "$k" ]; then echo "$2"; return; fi; shift; done; }
# STUB_SIG=INT|TERM and STUB_SIG_AT=<command>:<n>: signal the script during the n-th call of that command.
if [ -n "${STUB_SIG:-}" ] && [ "$cmd" = "${STUB_SIG_AT%%:*}" ]; then
  n=$(( $(get "sig_$cmd" 0) + 1 )); put "sig_$cmd" "$n"
  if [ "$n" = "${STUB_SIG_AT##*:}" ]; then signal_main "$STUB_SIG"; fi
fi
case "$svc $cmd" in
  "cloudformation describe-stacks")
    # Parameters come from the state file "threshold" (changed by update-stack). STUB_EXTRA_PARAMS=1 adds more parameters,
    # like a real stack: one NoEcho (the real API shows ****), one with an e-mail value, one number.
    extra=""
    if [ "${STUB_EXTRA_PARAMS:-0}" = 1 ]; then
      extra=',{"ParameterKey":"AlertEmail","ParameterValue":"alerts@example.invalid"},{"ParameterKey":"ApiSecretToken","ParameterValue":"****"},{"ParameterKey":"MonthlyBudgetUsd","ParameterValue":"20"}'
    fi
    cat <<JSON
{"Stacks":[{"StackStatus":"${STUB_STACK_STATUS:-UPDATE_COMPLETE}","Parameters":[{"ParameterKey":"DistributionId","ParameterValue":"$D"},{"ParameterKey":"ActionOnTrip","ParameterValue":"${STUB_ACTION:-Disable}"},{"ParameterKey":"RequestsPer5Min","ParameterValue":"$(get threshold "${STUB_THRESHOLD-10000}")"}$extra],
"Outputs":[{"OutputKey":"AlarmNames","OutputValue":"fake-stack-RequestsAlarm-X,fake-stack-BytesAlarm-Y"},{"OutputKey":"FunctionName","OutputValue":"$FN_NAME"}]}]}
JSON
    ;;
  "cloudformation update-stack")
    # STUB_UPDATE_FAIL_FROM=n: the n-th and every later update-stack call fails (a restore that keeps failing).
    if [ -n "${STUB_UPDATE_FAIL_FROM:-}" ]; then
      un=$(( $(get n_upd 0) + 1 )); put n_upd "$un"
      if [ "$un" -ge "$STUB_UPDATE_FAIL_FROM" ]; then echo "An error occurred (AccessDenied) when calling the UpdateStack operation: not authorized" >&2; exit 254; fi
    fi
    # Like CloudFormation: a parameter that is neither given nor UsePreviousValue would silently fall back to its template
    # default, so the stub refuses anything but RequestsPer5Min with a value and every other parameter with UsePreviousValue=true.
    case " $* " in *" --use-previous-template "*) ;; *) echo "stub: update-stack without --use-previous-template" >&2; exit 254 ;; esac
    case " $* " in *" --capabilities CAPABILITY_IAM "*) ;; *) echo "stub: update-stack without --capabilities CAPABILITY_IAM" >&2; exit 254 ;; esac
    if [ "${STUB_UPDATE_NOCHANGE:-0}" = 1 ]; then echo "An error occurred (ValidationError) when calling the UpdateStack operation: No updates are to be performed." >&2; exit 254; fi
    keys="DistributionId ActionOnTrip RequestsPer5Min"; [ "${STUB_EXTRA_PARAMS:-0}" = 1 ] && keys="$keys AlertEmail ApiSecretToken MonthlyBudgetUsd"
    on=0; seen=""
    for x in "$@"; do
      case "$x" in --parameters) on=1; continue ;; --*) on=0 ;; esac
      [ "$on" = 1 ] || continue
      k="${x#ParameterKey=}"; k="${k%%,*}"; seen="$seen $k"
      if [ "$k" = RequestsPer5Min ]; then
        case "$x" in *,ParameterValue=*) put threshold "${x##*,ParameterValue=}" ;; *) echo "stub: RequestsPer5Min needs a value" >&2; exit 254 ;; esac
      else
        case "$x" in "ParameterKey=$k,UsePreviousValue=true") ;; *) echo "stub: parameter $k must be UsePreviousValue=true, got: $x" >&2; exit 254 ;; esac
      fi
    done
    for k in $keys; do case " $seen " in *" $k "*) ;; *) echo "stub: parameter $k omitted (would reset to its default)" >&2; exit 254 ;; esac; done
    echo '{"StackId":"stub"}' ;;
  "cloudformation wait")
    if [ "${STUB_WAIT_FAIL:-0}" = 1 ]; then echo "Waiter StackUpdateComplete failed: Waiter encountered a terminal failure state" >&2; exit 255; fi
    ;;
  "cloudfront get-distribution-config")
    en=$(get enabled "${STUB_INIT_ENABLED:-true}")
    case "$*" in
      *"DistributionConfig.Enabled"*)
        lag=$(get lag 0); if [ "$lag" -gt 0 ]; then put lag $((lag - 1)); en=$(get prev_enabled true); fi
        if [ "$en" = true ]; then echo True; else echo False; fi ;;
      *) echo "{\"ETag\":\"$(get etag ETAG1)\",\"DistributionConfig\":{\"Comment\":\"fake\",\"Enabled\":$en}}" ;;
    esac ;;
  "cloudfront get-distribution")
    case "$*" in
      *"Distribution.Status"*)
        p=$(get pending 0)
        if [ "$p" -gt 0 ]; then put pending $((p - 1)); echo InProgress; else echo Deployed; fi ;;
      *) echo "{\"Distribution\":{\"DomainName\":\"dfaketest.cloudfront.net\",\"Status\":\"Deployed\",\"DistributionConfig\":{\"Aliases\":{\"Quantity\":1,\"Items\":[\"${STUB_ALIAS:-blog.fake-host.example}\"]}}}}" ;;
    esac ;;
  "lambda get-function-configuration")
    if [ "$(arg --function-name "$@")" != "$FN_NAME" ]; then echo "stub: ResourceNotFoundException: function not found" >&2; exit 254; fi
    case "$*" in *LoggingConfig.LogGroup*) echo "${STUB_LG_ANSWER-$LOG_GROUP_REAL}" ;; *) echo '{}' ;; esac ;;
  "cloudfront update-distribution")
    if [ "${STUB_PRECOND_ONCE:-0}" = 1 ] && [ "$(get precond_done 0)" = 0 ]; then
      put precond_done 1; put etag ETAG2   # somebody else changed the config: our ETag is stale
      echo "An error occurred (PreconditionFailed) when calling the UpdateDistribution operation: The If-Match version is missing or not valid" >&2; exit 254
    fi
    if [ "$(arg --if-match "$@")" != "$(get etag ETAG1)" ]; then echo "An error occurred (PreconditionFailed): stale ETag" >&2; exit 254; fi
    f="$(arg --distribution-config "$@")"; f="${f#file://}"
    set_enabled "$(jq -r '.Enabled' "$f")"; put pending 2; echo '{}' ;;
  "cloudwatch set-alarm-state")
    st="$(arg --state-value "$@")"
    put alarm "$st"; put reason "$(arg --state-reason "$@")"
    if [ "$st" = ALARM ]; then lambda_runs; fi
    case "${STUB_INT:-0}" in 1|INT) signal_main INT ;; TERM) signal_main TERM ;; READER) signal_main READER ;; esac ;;
  "cloudwatch describe-alarms")
    # --alarm-names takes several names. The requests alarm keeps its state in files; the bytes alarm is
    # STUB_BYTES_ALARM (default OK) with reason STUB_BYTES_REASON.
    names=""; on=0
    for x in "$@"; do
      case "$x" in --alarm-names) on=1; continue ;; --*) on=0 ;; esac
      if [ "$on" = 1 ]; then names="$names $x"; fi
    done
    out=""
    for nm in $names; do
      case "$nm" in
        *RequestsAlarm*)
          a=$(get alarm "${STUB_ALARM_INIT:-OK}")
          if [ "$a" = ALARM ]; then
            left=$(get alarm_ok_after 0)
            if [ "$left" -gt 0 ]; then put alarm_ok_after $((left - 1)); if [ "$left" = 1 ]; then put alarm OK; a=OK; fi; fi
          fi
          r="$(get reason "${STUB_ALARM_REASON:-none}")" ;;
        *) a="${STUB_BYTES_ALARM:-OK}"; r="${STUB_BYTES_REASON:-none}" ;;
      esac
      out="$out${out:+,}{\"AlarmName\":\"$nm\",\"StateValue\":\"$a\",\"StateReason\":\"$r\"}"
    done
    echo "{\"MetricAlarms\":[$out]}" ;;
  "cloudwatch describe-alarm-history")
    # Real CloudWatch answers in the caller's local offset; default -05:00 (the offset seen on the real run).
    off="${STUB_TS_OFFSET:--05:00}"
    case "$off" in Z) osec=0 ;; *) sign=1; [ "${off%"${off#?}"}" = "-" ] && sign=-1; o="${off#?}"; osec=$(( sign * (10#${o%%:*} * 3600 + 10#${o##*:} * 60) )) ;; esac
    iso_at() { local e=$(( $1 + osec )); date -u -r "$e" +%Y-%m-%dT%H:%M:%S 2>/dev/null || date -u -d "@$e" +%Y-%m-%dT%H:%M:%S; }
    if [ -n "${STUB_HIST_FAIL:-}" ]; then acct="$(printf '%s%s' 1234 56789012)"; echo "An error occurred (AccessDenied) when calling the DescribeAlarmHistory operation: User: arn:aws:sts::$acct:assumed-role/x is not authorized" >&2; exit 254; fi
    if [ -n "${STUB_HIST_AT:-}" ]; then
      # fixed history, newest first: an OK->ALARM entry at STUB_HIST_AT, an ALARM->OK a minute later, and an older ALARM entry an hour before
      echo "{\"AlarmHistoryItems\":[{\"Timestamp\":\"$(iso_at $((STUB_HIST_AT + 60))).500000$off\",\"HistorySummary\":\"Alarm updated from ALARM to OK\"},{\"Timestamp\":\"$(iso_at "$STUB_HIST_AT").217000$off\",\"HistorySummary\":\"Alarm updated from OK to ALARM\"},{\"Timestamp\":\"$(iso_at $((STUB_HIST_AT - 3600))).100000$off\",\"HistorySummary\":\"Alarm updated from OK to ALARM\"}]}"
    elif [ "$(get alarm OK)" = ALARM ] || [ "$(get lambda_fired 0)" = 1 ]; then
      echo "{\"AlarmHistoryItems\":[{\"Timestamp\":\"$(iso_at "$(date +%s)").123000$off\",\"HistorySummary\":\"Alarm updated from OK to ALARM\"}]}"
    else echo '{"AlarmHistoryItems":[]}'; fi ;;
  "logs filter-log-events")
    # Only the real log group exists; any other name fails like AWS does.
    # STUB_LG_LAZY=1: like AWS, the group only exists after the Lambda's first run (first log line).
    if [ "$(arg --log-group-name "$@")" != "$LOG_GROUP_REAL" ] || { [ "${STUB_LG_LAZY:-0}" = 1 ] && [ ! -s "$S/events" ]; }; then
      echo "An error occurred (ResourceNotFoundException) when calling the FilterLogEvents operation: The specified log group does not exist." >&2; exit 254
    fi
    st="$(arg --start-time "$@")"; en="$(arg --end-time "$@")"
    if [ -s "$S/events" ]; then
      case "$*" in
        *--no-paginate*)
          # real behavior: the first page can be EMPTY with a nextToken; the matching events are on a later page
          echo '{"events":[],"searchedLogStreams":[],"nextToken":"tok-page-2"}' ;;
        *)
          # the CLI follows nextToken itself and merges the pages
          jq -Rn --argjson st "$st" --argjson en "${en:-0}" '{events: [inputs | split("\t") | select((.[0] | tonumber) >= $st and ($en == 0 or (.[0] | tonumber) <= $en)) | {logStreamName: "s", timestamp: (.[0] | tonumber), message: .[1], eventId: "e"}]}' < "$S/events" ;;
      esac
    else echo '{"events":[],"searchedLogStreams":[]}'; fi ;;
  *) echo "stub aws: unexpected call: $svc $cmd $*" >&2; exit 99 ;;
esac
