#!/usr/bin/env bash
# Fake aws CLI for tests/run.sh. Understands only the calls the scripts make; anything else exits 99.
. "$(dirname "$0")/stub-lib.sh"
[ "$1" = "--region" ] && shift 2
svc="$1"; cmd="$2"; shift 2
echo "$svc $cmd $*" >> "$S/calls.log"
if [ -n "${STUB_FAIL_NTH:-}" ] && [ "$cmd" = "${STUB_FAIL_NTH%%:*}" ]; then
  n=$(( $(get "n_$cmd" 0) + 1 )); put "n_$cmd" "$n"
  if [ "$n" = "${STUB_FAIL_NTH##*:}" ]; then echo "stub: simulated failure of $cmd" >&2; exit 254; fi
fi
arg() { local k="$1"; shift; while [ $# -gt 0 ]; do if [ "$1" = "$k" ]; then echo "$2"; return; fi; shift; done; }
D="${STUB_DIST:-EFAKETEST1234}"
case "$svc $cmd" in
  "cloudformation describe-stacks")
    cat <<JSON
{"Stacks":[{"Parameters":[{"ParameterKey":"DistributionId","ParameterValue":"$D"},{"ParameterKey":"ActionOnTrip","ParameterValue":"${STUB_ACTION:-Disable}"},{"ParameterKey":"RequestsPer5Min","ParameterValue":"${STUB_THRESHOLD:-10000}"}],
"Outputs":[{"OutputKey":"AlarmNames","OutputValue":"fake-stack-RequestsAlarm-X,fake-stack-BytesAlarm-Y"},{"OutputKey":"FunctionName","OutputValue":"fake-stack-brake"}]}]}
JSON
    ;;
  "cloudfront get-distribution-config")
    en=$(get enabled "${STUB_INIT_ENABLED:-true}")
    case "$*" in
      *"DistributionConfig.Enabled"*) if [ "$en" = true ]; then echo True; else echo False; fi ;;
      *) echo "{\"ETag\":\"ETAG1\",\"DistributionConfig\":{\"Comment\":\"fake\",\"Enabled\":$en}}" ;;
    esac ;;
  "cloudfront get-distribution")
    p=$(get pending 0)
    if [ "$p" -gt 0 ]; then put pending $((p - 1)); echo InProgress; else echo Deployed; fi ;;
  "cloudfront update-distribution")
    if [ "$(arg --if-match "$@")" != ETAG1 ]; then echo "stub: PreconditionFailed" >&2; exit 254; fi
    f="$(arg --distribution-config "$@")"; f="${f#file://}"
    put enabled "$(jq -r '.Enabled' "$f")"; put pending 2; echo '{}' ;;
  "cloudwatch set-alarm-state")
    st="$(arg --state-value "$@")"
    put alarm "$st"; put reason "$(arg --state-reason "$@")"
    if [ "$st" = ALARM ]; then lambda_runs; fi
    if [ "${STUB_INT:-0}" = 1 ]; then kill -INT "$PPID"; fi ;;
  "cloudwatch describe-alarms")
    a=$(get alarm OK)
    if [ "$a" = ALARM ]; then
      left=$(get alarm_ok_after 0)
      if [ "$left" -gt 0 ]; then put alarm_ok_after $((left - 1)); if [ "$left" = 1 ]; then put alarm OK; a=OK; fi; fi
    fi
    echo "{\"MetricAlarms\":[{\"AlarmName\":\"fake\",\"StateValue\":\"$a\",\"StateReason\":\"$(get reason none)\"}]}" ;;
  "cloudwatch describe-alarm-history")
    if [ "$(get alarm OK)" = ALARM ] || [ "$(get lambda_fired 0)" = 1 ]; then
      echo "{\"AlarmHistoryItems\":[{\"Timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%S).123000+00:00\",\"HistorySummary\":\"Alarm updated from OK to ALARM\"}]}"
    else echo '{"AlarmHistoryItems":[]}'; fi ;;
  "logs filter-log-events")
    if [ "$(get lambda_fired 0)" = 1 ]; then
      if [ "${STUB_ACTION:-Disable}" = Disable ] || [ "${STUB_BREAK:-0}" = 1 ]; then m="[INFO] disabled distribution $D (alarm fake-stack-RequestsAlarm-X)"; else m="[INFO] AlertOnly: would disable $D (alarm fake)"; fi
      echo "[[$(( $(date +%s) * 1000 )),\"$m\"]]"
    else echo '[]'; fi ;;
  *) echo "stub aws: unexpected call: $svc $cmd $*" >&2; exit 99 ;;
esac
